{
  "name": "english-starry-sky",
  "version": "1.3.0",
  "type": "module",
  "description": "英语星空：人教版初中英语单词、课文点读、语法考点和中考真题练习网页",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test src/**/*.test.ts",
    "format": "prettier --write src vite.config.ts scripts/*.mjs package.json tsconfig.json"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.10.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/andika": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  },
  "private": true,
  "license": "MIT"
}
